/**
 * Matugen Dynamic Colors for Rofi (Translucent with Hyprland Blur)
 **/

* {
    background:     {{colors.surface.default.hex}}99;
    background-alt: {{colors.surface_container.default.hex}}B3;
    foreground:     {{colors.on_surface.default.hex}}FF;
    selected:       {{colors.primary.default.hex}}FF;
    active:         {{colors.tertiary.default.hex}}FF;
    urgent:         {{colors.error.default.hex}}FF;
}
